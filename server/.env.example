# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hireflow?retryWrites=true&w=majority

# Clerk Authentication (Secret Key for server verification)
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# SMTP / Email Provider Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM="HireFlow Recruiting" <your-email@example.com>

# Redis (BullMQ Queue - optional, fallback memory runner active if not connected)
REDIS_URL=redis://127.0.0.1:6379
